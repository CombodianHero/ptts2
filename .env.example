# ============================================================
# PRAKASH TOUR & TRAVELS — ENVIRONMENT VARIABLES (EXAMPLE)
# ============================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Never commit .env.local (or any real secrets) — it's already
# in .gitignore.
#
# For deployment, add these same keys in the Vercel dashboard
# under Project → Settings → Environment Variables (see
# DEPLOYMENT.md for the exact steps), NOT in this file.
#
# The current /api/*.js files are placeholders and do not read
# any of these yet — they're listed here as the seam for wiring
# up real functionality later. Each one is referenced in a
# comment inside the matching /api file.
# ============================================================

# ---- Payment gateway (used by api/create-order.js, api/verify-payment.js) ----
# Example shown for Razorpay — swap for Cashfree/PhonePe/etc. if you use a
# different provider. Get these from your payment gateway's dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Payment gateway webhook (used by api/webhook.js) ----
# The signing secret your gateway uses to sign webhook payloads, so you can
# verify a webhook actually came from them and wasn't forged.
RAZORPAY_WEBHOOK_SECRET=

# ---- UPI details (currently stored in-app under Admin → Settings) ----
# Only needed here if you move settings out of localStorage and into
# environment/database config instead.
UPI_ID=prakashtours@upi
UPI_DISPLAY_NAME=Prakash Tour & Travels

# ---- Database (needed once you replace localStorage with a real DB) ----
# Example for Postgres — use whatever connection string your provider
# (Vercel Postgres, Supabase, Neon, PlanetScale, etc.) gives you.
DATABASE_URL=

# ---- File storage (used by api/upload-receipt.js once implemented) ----
# Example for Vercel Blob. Generate this token from your Vercel project's
# Storage tab after creating a Blob store.
BLOB_READ_WRITE_TOKEN=

# ---- Admin authentication (replaces the current demo login) ----
# A long random string used to sign admin session cookies/JWTs.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- WhatsApp Cloud API (optional — only if you move off wa.me links to
# send automated messages, e.g. booking confirmations, from the server) ----
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---- Email — Resend (used by api/send-email.js) ----
# Real transactional email sending. Get RESEND_API_KEY from
# https://resend.com/api-keys after creating a free account.
# EMAIL_FROM must be on a domain you've verified in Resend
# (Resend dashboard -> Domains). Until you verify your own
# domain, Resend lets you send test emails from
# "onboarding@resend.dev" — fine for development, not for
# real customers.
RESEND_API_KEY=
EMAIL_FROM="Prakash Tour & Travels <bookings@yourdomain.com>"

# ---- App URL (used by api/send-email.js to build links inside emails,
# e.g. the "Complete Payment" button and "Check Booking Status" link) ----
# Local dev: http://localhost:3000   Production: your real Vercel/custom domain
APP_URL=http://localhost:3000
